generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

// 文件可见性:公共文件直链永久可访问;私有文件走签名地址,且只有本人/管理员能取
enum UploadVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  password    String
  // 只存上传记录的 ossId,不存 URL:换域名/CDN/签名策略都不用改库
  avatarOssId String?
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  todos       Todo[]
  tags        Tag[]
  uploads     Upload[]
  createdAt   DateTime   @default(now())
}

model Upload {
  // id 对外就是 ossId
  id           String           @id @default(uuid())
  key          String           @unique
  visibility   UploadVisibility @default(PRIVATE)
  // 原始文件名(带扩展名):文件类附件展示用,key 里只有随机名
  originalName String?
  mime         String
  size         Int
  uploader     User?            @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderId   Int?
  createdAt    DateTime         @default(now())
  // 被哪些 todo 附件引用
  todoAttachments TodoAttachment[]

  @@index([uploaderId])
  @@index([visibility])
}

// todo 与附件的关联表:一个 todo 可以挂多个文件,顺序用 sortOrder 记
model TodoAttachment {
  id        Int      @id @default(autoincrement())
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId    Int
  upload    Upload   @relation(fields: [ossId], references: [id], onDelete: Cascade)
  ossId     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([todoId, ossId])
  @@index([todoId])
  @@index([ossId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  todos     Todo[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Todo {
  id          Int              @id @default(autoincrement())
  title       String
  // 备注:非必填
  remark      String?
  completed   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  user        User             @relation(fields: [userId], references: [id])
  userId      Int
  // 附件:非必填,多个,走关联表
  attachments TodoAttachment[]
  tags        Tag[]

  @@index([userId])
}

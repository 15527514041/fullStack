generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

// 文件可见性:公共文件直链永久可访问;私有文件走签名地址,且只有本人/管理员能取
enum UploadVisibility {
  PUBLIC
  PRIVATE
}

// 标签类型:取值直接对应 Element Plus el-tag 的语义类型,前端不用再做映射
enum TagType {
  primary
  success
  info
  warning
  danger
}

// 标签域:标签管理是通用能力,各业务模块各用一套(任务 / 记账)
enum TagScope {
  TODO
  ACCOUNTING
}

// 每日规划的列表项类型:待办清单 / 计划完成 / 实际完成 / 随写备注
enum DailyPlanItemKind {
  TODO    // 待办事项:只有名称,序号即 sortOrder
  PLANNED // 计划完成:起止时间 + 事项(用时由起止时间算)
  ACTUAL  // 实际完成:同上
  NOTE    // 随写备注:只有内容
}

// 资产账户类型:先固定这几种,以后要支持自定义类型再改
enum AccountKind {
  WECHAT
  ALIPAY
  BANK
  CREDIT_CARD
  CASH
  OTHER
}

model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  password    String
  // 只存上传记录的 ossId,不存 URL:换域名/CDN/签名策略都不用改库
  avatarOssId String?
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  todos       Todo[]
  tags        Tag[]
  uploads     Upload[]
  reflections DailyReflection[]
  plans       DailyPlan[]
  ledgerAccounts LedgerAccount[]
  createdAt   DateTime   @default(now())
  // 最近一次登录成功的时间(登录时更新),后台用户列表展示用
  lastLoginAt DateTime?
  // 密码最后修改时间:签发时间早于它的 token 全部失效(改完密码即踢下线);null = 从没改过
  passwordChangedAt DateTime?
}

model Upload {
  // id 对外就是 ossId
  id           String           @id @default(uuid())
  key          String           @unique
  visibility   UploadVisibility @default(PRIVATE)
  // 原始文件名(带扩展名):文件类附件展示用,key 里只有随机名
  originalName String?
  mime         String
  size         Int
  uploader     User?            @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderId   Int?
  createdAt    DateTime         @default(now())
  // 被哪些 todo 附件引用
  todoAttachments TodoAttachment[]

  @@index([uploaderId])
  @@index([visibility])
}

// todo 与附件的关联表:一个 todo 可以挂多个文件,顺序用 sortOrder 记
model TodoAttachment {
  id        Int      @id @default(autoincrement())
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId    Int
  upload    Upload   @relation(fields: [ossId], references: [id], onDelete: Cascade)
  ossId     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([todoId, ossId])
  @@index([todoId])
  @@index([ossId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String
  type      TagType  @default(primary)
  // 标签所属的域:任务域的标签只给 TODO 用,记账域的只给记账用
  scope     TagScope @default(TODO)
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  todos     Todo[]
  createdAt DateTime @default(now())

  // 同一个域内不允许重名,不同域可以有同名标签(唯一索引的前缀也顺带覆盖「按域取标签」的查询)
  @@unique([userId, scope, name])
}

model Todo {
  id          Int              @id @default(autoincrement())
  title       String
  // 备注:非必填
  remark      String?
  completed   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  // 最近一次更新时间:@updatedAt 每次写库自动刷新;@default(now()) 是为了给已有数据直接补列
  updatedAt   DateTime         @default(now()) @updatedAt
  deletedAt   DateTime?
  user        User             @relation(fields: [userId], references: [id])
  userId      Int
  // 附件:非必填,多个,走关联表
  attachments TodoAttachment[]
  tags        Tag[]

  @@index([userId])
}

// ===== 个人成长:每日反思 =====
// 一天一条(date + userId 唯一),记录里挂多条反思项
model DailyReflection {
  id        Int              @id @default(autoincrement())
  // 只存年月日:接口收发都用 YYYY-MM-DD,落库固定 UTC 零点,避免时区把日期挪一天
  date      DateTime         @db.Date
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  items     ReflectionItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // 唯一索引本身就覆盖 (userId, date) 查询,不用再建普通索引
  @@unique([userId, date])
}

// 反思项:描述经过 + 分析原因 + 改进措施
model ReflectionItem {
  id           Int             @id @default(autoincrement())
  reflection   DailyReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  reflectionId Int
  experience   String
  reason       String?
  measure      String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([reflectionId])
}

// ===== 个人成长:每日规划 =====
// 一天一条(date + userId 唯一),记录里挂四类列表项(待办 / 计划完成 / 实际完成 / 随写备注)
model DailyPlan {
  id        Int             @id @default(autoincrement())
  date      DateTime        @db.Date
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  items     DailyPlanItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, date])
}

// 规划列表项:四类共用一张表,用 kind 区分
model DailyPlanItem {
  id        Int               @id @default(autoincrement())
  plan      DailyPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    Int
  kind      DailyPlanItemKind
  // 待办名称 / 事项 / 随写备注的内容
  name      String
  // HH:mm;TODO 类没有时间,PLANNED / ACTUAL 由接口层强制必填
  startTime String?
  endTime   String?
  // 待办是否已完成(勾上=完成,界面上文字加删除线);其它三类恒为 false
  completed Boolean           @default(false)
  // 计划 / 实际是否标记为重要(点亮小三角);待办与随写恒为 false
  important Boolean           @default(false)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())

  @@index([planId, kind])
}

// ===== 记账:资产账户 =====
// 余额是用户手动维护的「快照」:账单流水不联动修改余额,这是产品原则不是偷懒
model LedgerAccount {
  id               Int         @id @default(autoincrement())
  userId           Int
  name             String
  kind             AccountKind
  // 备注:放「尾号 1234」这类信息
  note             String?
  // 余额,单位分;信用卡欠款记负数
  balanceCents     Int         @default(0)
  // 上次手动改余额的时间:只在余额真的变了才刷新,用于「很久没对账」提醒
  balanceUpdatedAt DateTime    @default(now())
  // 启用开关:只是个标记 —— 停用的账户不再出现在录入选择里,但余额照算、数据保留
  enabled          Boolean     @default(true)
  sortOrder        Int         @default(0)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // 同一用户内账户不重名;唯一索引前缀也顺带覆盖「按用户取账户」的查询
  @@unique([userId, name])
  @@index([userId, enabled])
}

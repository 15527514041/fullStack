# PostgreSQL 连接串(生成强密码:openssl rand -hex 16)
DATABASE_URL="postgresql://fullstack:你的密码@127.0.0.1:5432/fullstack"

# JWT 签名密钥(生成:openssl rand -hex 32),生产必须唯一且保密
JWT_SECRET="你的64位密钥"

# 服务端口
PORT=3008

# 允许跨域的来源(逗号分隔);生产同域部署可以不配
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ===== 阿里云 OSS(上传存储) =====
# 建议用 RAM 子账号,只授予该 bucket 的 PutObject / PutObjectAcl / GetObject / DeleteObject
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=你的bucket名
OSS_ACCESS_KEY_ID=你的RAM子账号AK
OSS_ACCESS_KEY_SECRET=你的RAM子账号SK
# 访问地址前缀(公共直链用)
OSS_PUBLIC_BASE_URL=https://你的bucket.oss-cn-shenzhen.aliyuncs.com
# 私有文件签名地址有效期(秒),默认 3600
OSS_SIGNED_URL_TTL=3600
# 单个文件大小上限(MB),默认 10
OSS_MAX_SIZE_MB=10
